# --- LLM (RAG answer generation) ---
# Required when LLM_PROVIDER=openai (the default, faithful to the article).
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0

# --- Embeddings (vector store) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- OCR backend ---
# auto      -> use Unlimited-OCR if a CUDA GPU is available, else the CPU fallback
# unlimited -> force the real Baidu Unlimited-OCR model (needs GPU)
# fallback  -> force the CPU fallback OCR engine
OCR_BACKEND=auto
OCR_MODEL=baidu/Unlimited-OCR
OCR_DPI=300

# --- Retrieval / chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=3
